<article class="article">
  <header class="article-header"><p class="eyebrow">TRANSMISSION / <%= date(page.date, 'YYYY.MM.DD') %></p><h1><%= page.title %></h1></header>
  <% if (page.media_type === 'model' && page.media_url) { %>
    <%- partial('_partial/model-preview', { modelUrl: page.media_url, modelTitle: page.title, modelSize: 'large' }) %>
  <% } %>
  <div class="article-content"><%- page.content %></div>
</article>
