<%
  var latestPosts = site.posts.sort('date', -1).limit(6);
  var indexWalineReady = String((theme.waline && theme.waline.serverURL) || '').trim().length > 0;
  var geoEntries = [];
  site.posts.forEach(function (post) {
    var location = post.location;
    if (!location || location.lat === undefined || location.lng === undefined) return;
    geoEntries.push({ title: String(post.title || 'UNTITLED'), date: date(post.date, 'YYYY.MM.DD'), label: String(location.label || location.name || 'UNNAMED NODE'), lat: Number(location.lat), lng: Number(location.lng), type: String(post.media_type || 'note').toUpperCase(), url: url_for(post.path) });
  });
%>
<section class="crt-home" aria-label="SSY signal archive">
  <div class="crt-home-noise" aria-hidden="true"></div>
  <div class="crt-topline"><span data-i18n-zh="SSY // 个人信号档案" data-i18n-en="SSY // PERSONAL SIGNAL ARCHIVE">SSY // PERSONAL SIGNAL ARCHIVE</span><span class="crt-topline-status"><span data-i18n-zh="系统状态：" data-i18n-en="SYS.STATUS: ">SYS.STATUS: </span><b data-i18n-zh="在线" data-i18n-en="ONLINE">ONLINE</b><span class="crt-home-controls"><button type="button" class="crt-control-button" data-theme-toggle aria-pressed="false"><span class="theme-toggle-icon">☾</span><span data-theme-label>Dark</span></button><button type="button" class="crt-control-button crt-language-button" data-language-toggle aria-pressed="false" aria-label="切换语言"><span data-language-label>中文 / En</span></button></span></span></div>
  <div class="crt-hero-grid">
    <div class="crt-hero-copy"><p class="eyebrow" data-i18n-zh="频道 01 / CRT 传输" data-i18n-en="CHANNEL 01 / CRT TRANSMISSION">CHANNEL 01 / CRT TRANSMISSION</p><h1><span data-i18n-zh="你好，" data-i18n-en="HELLO,">HELLO,</span><br><em data-i18n-zh="我是" data-i18n-en="I AM">I AM</em><br><strong>S S Y</strong></h1><p class="crt-lede" data-i18n-zh="一个手工搭建的档案，收录札记、图片、声音与未完成的信号。" data-i18n-en="A hand-built archive for notes, images, sound and unfinished signals.">A hand-built archive for notes, images, sound and unfinished signals.</p><div class="crt-readout"><span data-i18n-zh="运行时间" data-i18n-en="UPTIME">UPTIME</span><b>2026—NOW</b><span data-i18n-zh="模式" data-i18n-en="MODE">MODE</span><b data-i18n-zh="模拟 / 数字" data-i18n-en="ANALOG / DIGITAL">ANALOG / DIGITAL</b><span data-i18n-zh="访客" data-i18n-en="VISITOR">VISITOR</span><b data-visitor-card>—</b></div></div>
    <div class="crt-monitor" data-crt-monitor><div class="crt-monitor-bezel"><div class="crt-monitor-head"><span data-i18n-zh="显示器 // 01" data-i18n-en="MONITOR // 01">MONITOR // 01</span><span class="crt-rec"><i></i> <span data-i18n-zh="录制" data-i18n-en="REC">REC</span></span></div><div class="crt-screen"><div class="crt-screen-grid"></div><div class="crt-screen-copy"><span data-i18n-zh="启动序列" data-i18n-en="BOOT SEQUENCE">BOOT SEQUENCE</span><strong><span data-i18n-zh="档案" data-i18n-en="ARCHIVE">ARCHIVE</span><br><span data-i18n-zh="就绪" data-i18n-en="READY">READY</span></strong><small data-i18n-zh="拖动地球 / 寻找信号" data-i18n-en="DRAG THE EARTH / FIND A SIGNAL">DRAG THE EARTH / FIND A SIGNAL</small></div><div class="crt-crosshair" aria-hidden="true"></div></div><div class="crt-monitor-foot"><span>HZ 60.00</span><span data-i18n-zh="连接：稳定" data-i18n-en="CONNECTION: STABLE">CONNECTION: STABLE</span></div></div></div>
  </div>
  <div class="crt-dashboard"><div class="crt-dashboard-label"><span>LIVE CARTOGRAPHY / FIELD NOTES</span><span><%= String(geoEntries.length).padStart(2, '0') %> NODES</span></div><div class="crt-dashboard-grid">
    <section class="globe-console" aria-label="Interactive archive globe"><div class="globe-console-head"><div><p class="eyebrow" data-i18n-zh="轨道索引" data-i18n-en="ORBITAL INDEX">ORBITAL INDEX</p><h2 data-i18n-zh="地球 / 信号地图" data-i18n-en="EARTH / SIGNAL MAP">EARTH / SIGNAL MAP</h2></div><span data-i18n-zh="按住并拖动旋转" data-i18n-en="HOLD + DRAG TO ROTATE">HOLD + DRAG TO ROTATE</span></div><div class="globe-stage" data-globe-stage tabindex="0" aria-label="可拖动的札记位置地球"><canvas data-globe-canvas></canvas><div class="globe-tooltip" data-globe-tooltip hidden></div><div class="globe-empty" data-globe-empty <%= geoEntries.length ? 'hidden' : '' %>><span data-i18n-zh="暂无位置数据" data-i18n-en="NO LOCATION DATA">NO LOCATION DATA</span><br><small data-i18n-zh="请在文章 front-matter 中添加位置" data-i18n-en="Add location to a post front-matter">Add location to a post front-matter</small></div></div><div class="globe-console-foot"><span>LAT <b data-globe-lat>000.0</b></span><span>LNG <b data-globe-lng>000.0</b></span><span>ZOOM <b>1.00X</b></span><span class="visitor-status" data-visitor-status aria-live="polite">VISITOR: LOCATING…</span><span class="visitor-distance" data-visitor-distance aria-live="polite">SSY DIST: —</span></div><p class="globe-privacy-note" data-i18n-zh="访客位置为基于 IP 的粗略估计。此处不会保存原始 IP。" data-i18n-en="Visitor location is approximate and derived from IP. No raw IP is stored here.">Visitor location is approximate and derived from IP. No raw IP is stored here.</p></section>
    <aside class="signal-list" aria-label="Archive location list"><div class="signal-list-head"><span data-i18n-zh="现场信号" data-i18n-en="FIELD SIGNALS">FIELD SIGNALS</span><span data-i18n-zh="悬停查看" data-i18n-en="HOVER TO INSPECT">HOVER TO INSPECT</span></div><% if (geoEntries.length) { %><% geoEntries.forEach(function (entry, index) { %><a class="signal-row" href="<%= entry.url %>" data-signal-index="<%= index %>"><span class="signal-row-no"><%= String(index + 1).padStart(2, '0') %></span><span class="signal-row-copy"><strong><%= entry.title %></strong><small><%= entry.label %> / <%= entry.date %></small></span><span class="signal-row-type"><%= entry.type %></span></a><% }); %><% } else { %><p class="signal-list-empty"><span data-i18n-zh="暂无已映射信号" data-i18n-en="No mapped signals yet.">No mapped signals yet.</span><br><span data-i18n-zh="请在文章中使用" data-i18n-en="Use">Use</span> <code>location</code> <span data-i18n-zh="字段" data-i18n-en="in a post.">in a post.</span></p><% } %></aside>
  </div></div>
</section>
<section class="posts-section crt-posts-section" aria-label="Latest posts"><div class="section-heading"><h2 data-i18n-zh="最新记录" data-i18n-en="Latest transmissions">Latest transmissions</h2><span><%= latestPosts.length %> <span data-i18n-zh="篇文章" data-i18n-en="posts">posts</span></span></div><% if (!latestPosts.length) { %><div class="empty-state"><div class="empty-icon">&#10022;</div><h3 data-i18n-zh="这里暂时很安静" data-i18n-en="It is quiet here for now">It is quiet here for now</h3><p data-i18n-zh="你的第一篇文章即将到来。" data-i18n-en="Your first post is on its way.">Your first post is on its way.</p></div><% } else { %><div class="post-list"><% latestPosts.forEach(function (post, index) { %><article class="post-card"><span class="post-card-index"><%= String(index + 1).padStart(2, '0') %></span><div class="post-card-body"><p class="eyebrow"><%= date(post.date, 'YYYY.MM.DD') %></p><h3><a href="<%= url_for(post.path) %>"><%= post.title %></a></h3><p><%= strip_html(post.excerpt || post.content).slice(0, 180) %></p><% if (indexWalineReady) { %><p class="post-card-view"><span data-i18n-zh="浏览" data-i18n-en="Views">浏览</span> <span class="waline-pageview-count" data-path="/<%= post.path %>">—</span> <span data-i18n-zh="次" data-i18n-en="times">次</span></p><% } %></div><a class="post-card-arrow" href="<%= url_for(post.path) %>" aria-label="Open <%= post.title %>">&#8599;</a></article><% }); %></div><% } %></section>
<script type="application/json" id="globe-data"><%- JSON.stringify(geoEntries) %></script>
