<%
  var searchEntries = [];
  site.posts.forEach(function (post) {
    searchEntries.push({ title: post.title, url: url_for(post.path), type: 'NOTE', text: strip_html(post.content || '') });
  });
  site.pages.forEach(function (item) {
    if (!/index\.html$/.test(item.path || '')) return;
    if (item.path === 'search/index.html') return;
    searchEntries.push({ title: item.title || 'PAGE', url: url_for(item.path), type: 'PAGE', text: strip_html(item.content || '') });
  });
  var searchPayload = JSON.stringify(searchEntries).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026');
%>
<div class="search-backdrop" data-search-close></div>
<section class="search-panel" data-search-panel aria-label="Search blog" aria-hidden="true">
  <div class="search-panel-head"><div><p class="eyebrow">SYSTEM QUERY / 01</p><h2>SEARCH ARCHIVE</h2></div><button type="button" class="search-close" data-search-close aria-label="Close search">×</button></div>
  <div class="search-input-wrap"><span>⌕</span><input type="search" data-search-input placeholder="Search notes, pages, audio..." autocomplete="off"><kbd>ESC</kbd></div>
  <div class="search-result-meta"><span data-search-status>TYPE TO SEARCH</span><span data-search-count>0 RESULTS</span></div>
  <div class="search-results" data-search-results><p class="archive-empty">Search across the blog archive.</p></div>
  <script type="application/json" data-search-index><%- searchPayload %></script>
</section>
