<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= page.title ? page.title + ' · ' : '' %><%= config.title %></title>
  <meta name="description" content="<%= page.description || config.description %>">
  <link rel="stylesheet" href="<%= url_for('/css/main.css') %>">
</head>
<body>
  <div class="site-shell">
    <header class="site-header">
      <a class="brand" href="<%= url_for('/') %>">
        <span class="brand-mark">✳</span>
        <span><%= config.title %></span>
      </a>
      <nav class="site-nav" aria-label="主导航">
        <% Object.keys(theme.menu || {}).forEach(function(label) { %>
          <a href="<%= url_for(theme.menu[label]) %>"><%= label %></a>
        <% }) %>
      </nav>
    </header>
    <main class="site-main"><%- body %></main>
    <footer class="site-footer">
      <span>© <%= new Date().getFullYear() %> <%= config.author %></span>
      <span class="footer-links">
        <% Object.keys(theme.social || {}).forEach(function(label) { %>
          <a href="<%= theme.social[label] %>"><%= label %></a>
        <% }) %>
      </span>
    </footer>
  </div>
</body>
</html>
